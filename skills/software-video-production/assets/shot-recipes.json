{
  "schema_version": 2,
  "status": "twelve_core_components_plus_optional_series_recap; not upstream shotcraft",
  "render_owner": "choose_existing_pipeline_or_remotion_or_hyperframes",
  "required_per_shot": [
    "id",
    "recipe",
    "source_id",
    "source_in",
    "source_out",
    "claim",
    "evidence",
    "trigger",
    "visible_result",
    "focus_region",
    "privacy_derivative",
    "caption_role",
    "audio_events",
    "human_review"
  ],
  "recipes": [
    {
      "id": "before_after",
      "purpose": "同一任务和条件下的前态、触发与真实后态",
      "parameters": [
        "before_range",
        "after_range",
        "comparison_region",
        "condition_differences"
      ],
      "checks": [
        "same_scale_and_region",
        "actual_result_visible",
        "no_false_instant_completion"
      ]
    },
    {
      "id": "detail_zoom",
      "purpose": "先定位完整界面，再读懂真实局部，再回到上下文",
      "parameters": [
        "context_range",
        "roi_in_source_pixels",
        "readable_hold",
        "return_range"
      ],
      "checks": [
        "raster_redaction_before_transform",
        "native_pixel_limit",
        "mobile_safe_area",
        "readable_hold"
      ]
    },
    {
      "id": "step_progression",
      "purpose": "目标、单步操作、可见反馈、下一步",
      "parameters": [
        "goal",
        "step_ranges",
        "state_dependencies",
        "feedback_ranges"
      ],
      "checks": [
        "causal_order",
        "waiting_time_truthful",
        "one_focus_per_step"
      ]
    },
    {
      "id": "metric_compare",
      "purpose": "同条件、同尺度的非负量级比较",
      "parameters": [
        "items",
        "unit",
        "maxValue"
      ],
      "checks": [
        "shared_zero_baseline",
        "final_values_accurate",
        "readable_hold"
      ]
    },
    {
      "id": "trend_trace",
      "purpose": "沿样本顺序揭示变化",
      "parameters": [
        "points",
        "unit",
        "highlightIndex"
      ],
      "checks": [
        "real_x_spacing_preserved",
        "samples_not_invented",
        "stable_endpoint"
      ]
    },
    {
      "id": "target_gap",
      "purpose": "实际值与目标的差距",
      "parameters": [
        "actual",
        "target",
        "unit",
        "maxValue"
      ],
      "checks": [
        "fixed_target",
        "no_numeric_overshoot",
        "units_match"
      ]
    },
    {
      "id": "evidence_focus",
      "purpose": "保留期待，按需要减少证据之间的竞争",
      "parameters": [
        "items",
        "reduceDistractions",
        "focusStartFrame",
        "claimStartFrame",
        "prompt"
      ],
      "checks": [
        "reduction_optional",
        "no_forced_blank",
        "core_claim_readable"
      ]
    },
    {
      "id": "causal_flow",
      "purpose": "顺着触发与反馈解释状态交接",
      "parameters": [
        "steps"
      ],
      "checks": [
        "causal_order",
        "diagram_not_real_execution"
      ]
    },
    {
      "id": "task_router",
      "purpose": "一个输入与多个条件去向",
      "parameters": [
        "origin",
        "routes"
      ],
      "checks": [
        "conditions_clear",
        "diagram_not_performance_evidence"
      ]
    },
    {
      "id": "claim_reveal",
      "purpose": "观点进入后稳定阅读",
      "parameters": [
        "claim",
        "support",
        "kicker"
      ],
      "checks": [
        "one_focus",
        "settled_text"
      ]
    },
    {
      "id": "spotlight_roi",
      "purpose": "保留上下文并突出展示区域",
      "parameters": [
        "roi",
        "image"
      ],
      "checks": [
        "raster_redaction_before_focus",
        "roi_calibrated_on_display",
        "aspect_preserved"
      ]
    },
    {
      "id": "match_transition",
      "purpose": "共享语义对象连接前后",
      "parameters": [
        "from",
        "to",
        "bridge"
      ],
      "checks": [
        "semantic_connection",
        "no_decorative_delay"
      ]
    },
    {
      "id": "previous_episode",
      "purpose": "同一已发布作品的封面与制作时累计数据回顾",
      "parameters": [
        "previous",
        "image",
        "series",
        "visualStyle"
      ],
      "checks": [
        "matched_work_id",
        "snapshot_timestamp",
        "missing_not_zero",
        "private_assets_not_distributed"
      ]
    }
  ],
  "invariants": [
    "original_or_owned_source",
    "source_hash_checked_before_render",
    "solid_privacy_mask_before_motion",
    "nonzero_required_audio_branches",
    "semantic_review_pending_until_reviewed",
    "no_platform_retention_claim_without_data"
  ],
  "render_entry": "scripts/render_shots.cjs",
  "implementation": "assets/remotion-software/entry.jsx",
  "usage_and_limits": "docs/integration.md",
  "optional_decision_fields": [
    "information_relation",
    "settled_reading_state",
    "reduction_reason",
    "continuing_expectation",
    "motion_case",
    "selection_reason",
    "motion_case_validation"
  ],
  "motion_reference": "docs/motion.md",
  "series_reference": "docs/series.md",
  "advanced_case_catalog": "assets/advanced-cases.json",
  "advanced_case_reference": "docs/advanced-cases.md",
  "automatic_selection_entry": "scripts/select_motion.py"
}
